(define (problem costly_delivery_p2)
  (:domain costly_delivery)
  (:objects
    kobuki - robot
    dock hall stairs lab office - room
    parcel letter - package
  )
  (:init
    (robot_at kobuki dock)
    (package_at parcel dock)
    (package_at letter lab)
    (connected dock stairs)
    (connected stairs dock)
    (connected stairs office)
    (connected office stairs)
    (connected dock hall)
    (connected hall dock)
    (connected hall lab)
    (connected lab hall)
    (connected lab office)
    (connected office lab)
    (= (distance dock stairs) 20)
    (= (distance stairs dock) 20)
    (= (distance stairs office) 20)
    (= (distance office stairs) 20)
    (= (distance dock hall) 2)
    (= (distance hall dock) 2)
    (= (distance hall lab) 2)
    (= (distance lab hall) 2)
    (= (distance lab office) 2)
    (= (distance office lab) 2)
    (= (total-cost) 0)
  )
  (:goal (and
    (package_at parcel office)
    (package_at letter office)
  ))
  (:metric minimize (total-cost))
)
