<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plansys2_state_updater</name>
  <version>4.0.0</version>

  <description>Keeps the PlanSys2 problem in sync with the sensors, configured by YAML rules</description>

  <maintainer email="jc.manzanares.serrano@gmail.com">Juan Carlos Manzanares Serrano</maintainer>

  <license>Apache License, Version 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rcpputils</depend>
  <depend>rmw</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>pluginlib</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_pddl_parser</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_problem_expert</depend>

  <!-- For examples/replanning_mission.py -->
  <exec_depend>plansys2_support_py</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>plansys2_bringup</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ros2launch</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>plansys2_lifecycle_manager</test_depend>
  <test_depend>sensor_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <plansys2_state_updater plugin="${prefix}/plugins.xml"/>
    <plansys2_problem_expert plugin="${prefix}/updater_plugins.xml"/>
  </export>
</package>
